__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Databases. The pseudonym vault holds the mapping from pseudonym back to
# personnel_id *and* the HMAC salt that produced it, so committing it would
# undo the pseudonymisation for anyone who cloned the repo. Regenerate it with
# scripts/generate_synthetic_data.py.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Self-assessment answers written by the running API. Runtime state, and
# somebody's own words — not build output, and not ours to publish.
data/responses/

# Agent/AI tooling skill packs. Vendored third-party content, not product code
# and not ours to redistribute. Kept locally, out of the repo.
.agents/

# Ignore Visual Studio Code workspace settings
.vscode/

# Generated rating sheets and their analysis. Regenerable from any pipeline run
# with validation/build_rating_profiles.py. The CSV deliberately carries the
# model's own answer in a `model_score` column, which must be deleted before a
# rater ever sees the sheet -- a copy sitting in the repo is a copy that can be
# handed over by accident, and a rater who has seen the score is no longer an
# independent judgement.
validation/rating_profiles.csv
validation/rating_profiles.md
validation/human_rating_results.json
